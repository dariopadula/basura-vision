# local es el valor predeterminado cuando APP_ENV no existe.
APP_ENV=local
BV_STORAGE=local
BV_DATA_ROOT=data/photos
BV_MODEL_PATH=models/active/best.pt
BV_RUNS_ROOT=runs
BV_ANNOTATIONS_PATH=data/annotations/annotations.json
BV_HOST=127.0.0.1
BV_VIEWER_PORT=8765
BV_ANNOTATOR_PORT=8768

# Cloudera/CML (requeridas cuando APP_ENV=cloudera)
# BV_STORAGE=s3
# BV_S3_CONNECTION=S3 Object Store
# BV_S3_BUCKET=mi_bucket
# BV_S3_PREFIX=data/AD/yolo_vision/data
# BV_MODEL_OBJECT=models/active/best.pt
# BV_TEMP_ROOT=/tmp/basura_vision
# BV_RUN_ID=reference_30_application
# BV_RUN_SOURCE=runs/reference_30_cloudera
# BV_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# BV_BEDROCK_REGION=us-east-1
# En una sesión CML, los comandos de docs/visores_cloudera.md usan
# BV_HOST=127.0.0.1 y los puertos CDSW_* asignados por Cloudera.

