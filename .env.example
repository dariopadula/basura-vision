# local es el valor predeterminado cuando APP_ENV no existe.
APP_ENV=local
BV_STORAGE=local
BV_DATA_ROOT=data/photos
BV_MODEL_PATH=models/active/best.pt
BV_RUNS_ROOT=runs
BV_ANNOTATIONS_PATH=data/annotations/annotations.json
BV_HOST=127.0.0.1
BV_VIEWER_PORT=8765
BV_ANNOTATOR_PORT=8768

